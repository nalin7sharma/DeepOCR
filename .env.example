# Web entry point
DEEP_OCR_BIND_ADDRESS=127.0.0.1
DEEP_OCR_PORT=8080

# Upload and decoding resource bounds
OCR_MAX_UPLOAD_BYTES=104857600
OCR_MAX_PAGES=100
OCR_MAX_IMAGE_DIMENSION=10000
OCR_MAX_PIXELS_PER_PAGE=40000000
OCR_MAX_TOTAL_PIXELS=100000000
OCR_PDF_RENDER_SCALE=2
# Region confidences below this threshold receive a human-review marker.
OCR_REVIEW_CONFIDENCE_THRESHOLD=0.45
OCR_LANGUAGE=en

# Tune these values to the host machine and expected workload.
API_MEMORY_LIMIT=6g
API_CPU_LIMIT=4.0
WEB_MEMORY_LIMIT=128m

# Recognition engines: paddle | crnn | cnn_bilstm | trocr | trocr_ft
OCR_DEFAULT_ENGINE=paddle
# Pretrained TrOCR model (the fine-tuned copy lives in checkpoints/trocr_finetuned)
OCR_TROCR_MODEL=microsoft/trocr-small-handwritten
# Load PaddleOCR and the trained CTC models at startup (1) or on first use (0)
OCR_WARMUP=1
